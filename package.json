    "fake-client": "node scripts/fake-lcu.mjs",
    "test:ingest": "node --test scripts/ingest/*.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5"
  }
}
