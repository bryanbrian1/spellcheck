{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spellcheck",
  "version": "0.1.1",
  "identifier": "com.spellcheck.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "spellcheck",
        "width": 420,
        "height": 700,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://ddragon.leagueoflegends.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyOUEyNDEzNDNGMkEyQzcKUldUSG92SkRFeVNhY3A0RDJzRkw0WjZmNVdGOGVHMUFUWEtYTjdpVlZ3ZXoxczlFUkc1L0RvelIK",
      "endpoints": [
        "https://updates.spellcheck.gg/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../data/builds": "data/builds"
    },
    "category": "Utility",
    "shortDescription": "Champion select build lookup",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
