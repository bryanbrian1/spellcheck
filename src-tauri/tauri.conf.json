{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "leaguechecker",
  "version": "0.1.0",
  "identifier": "com.leaguechecker.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "leaguechecker",
        "width": 420,
        "height": 700,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://ddragon.leagueoflegends.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Champion select build lookup",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
